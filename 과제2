from tensorflow.keras import layers, models
import tensorflow as tf

def residual_conv_block(x, filters):

    shortcut = x

    # 첫 번째 합성곱 + Batch Normalization
    x = layers.Conv2D(
        filters, (3, 3), padding="same", use_bias=False
    )(x)
    x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)

    # 두 번째 합성곱 + Batch Normalization
    x = layers.Conv2D(
        filters, (3, 3), padding="same", use_bias=False
    )(x)
    x = layers.BatchNormalization()(x)

    # Skip Connection
    x = layers.Add()([x, shortcut])
    x = layers.Activation("relu")(x)

    return x

# 입력층
inputs = layers.Input(shape=(32, 32, 3))

# 첫 번째 합성곱층
x = layers.Conv2D(
    32, (3, 3), padding="same", use_bias=False
)(inputs)
x = layers.BatchNormalization()(x)
x = layers.Activation("relu")(x)

# 첫 번째 Residual Block
x = residual_conv_block(x, 32)

# Pooling
x = layers.MaxPooling2D((2, 2))(x)

# 두 번째 Residual Block
x = residual_conv_block(x, 32)

# Global Average Pooling
x = layers.GlobalAveragePooling2D()(x)

# 출력층
outputs = layers.Dense(10, activation="softmax")(x)

# CNN 모델
model_cnn = models.Model(inputs, outputs)

model_cnn.compile(
    optimizer=tf.keras.optimizers.Adam(learning_rate=0.001),
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"]
)

model_cnn.summary()

