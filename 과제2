def residual_dense_block(x, units):

    shortcut = x

    # 첫 번째 Dense + Batch Normalization
    x = layers.Dense(units)(x)
    x = layers.BatchNormalization()(x)
    x = layers.Activation("relu")(x)

    # 두 번째 Dense + Batch Normalization
    x = layers.Dense(units)(x)
    x = layers.BatchNormalization()(x)

    # Skip Connection
    x = layers.Add()([x, shortcut])
    x = layers.Activation("relu")(x)

    return x

