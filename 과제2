import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.metrics import mean_squared_error

# 원래 설명변수 목록
original_features = [
    "mnth", "hr", "workingday", "weathersit", "temp"
]

# 원-핫 인코딩된 열을 원래 변수별로 묶기
feature_groups = {}

for feature in original_features:
    if feature in X_test.columns:
        feature_groups[feature] = [feature]
    else:
        feature_groups[feature] = [
            col for col in X_test.columns
            if col.startswith(feature + "_")
        ]

print(feature_groups)

def predict_bike(model_name, X_input):

    if model_name == "RF":
        return model_rf.predict(X_input)

    # DNN과 CNN은 표준화 적용
    X_scaled = scaler.transform(X_input)

    if model_name == "DNN":
        return model_dnn_bike.predict(
            X_scaled, verbose=0
        ).flatten()

    elif model_name == "1D-CNN":
        X_cnn = X_scaled.reshape(
            X_scaled.shape[0],
            X_scaled.shape[1],
            1
        )

        return model_cnn_bike.predict(
            X_cnn, verbose=0
        ).flatten()

def calculate_pfi(model_name, X_data, y_data,
                  n_repeats=10, random_state=42):

    rng = np.random.default_rng(random_state)

    # 원래 RMSE
    original_pred = predict_bike(model_name, X_data)
    original_rmse = np.sqrt(
        mean_squared_error(y_data, original_pred)
    )

    importance = {}

    for feature, columns in feature_groups.items():

        scores = []

        for _ in range(n_repeats):

            X_permuted = X_data.copy()

            # 같은 순열을 사용해 관련 더미변수들을 함께 섞음
            perm_idx = rng.permutation(len(X_data))

            X_permuted.loc[:, columns] = (
                X_data[columns].iloc[perm_idx].to_numpy()
            )

            perm_pred = predict_bike(
                model_name, X_permuted
            )

            perm_rmse = np.sqrt(
                mean_squared_error(y_data, perm_pred)
            )

            scores.append(perm_rmse - original_rmse)

        importance[feature] = np.mean(scores)

    return pd.Series(importance)

pfi_dnn = calculate_pfi("DNN", X_test, y_test)
pfi_cnn = calculate_pfi("1D-CNN", X_test, y_test)
pfi_rf = calculate_pfi("RF", X_test, y_test)

pfi_results = pd.DataFrame({
    "DNN": pfi_dnn,
    "1D-CNN": pfi_cnn,
    "Random Forest": pfi_rf
})

print(pfi_results.round(4))

import shap

# 계산 시간을 줄이기 위한 표본 추출
X_background = X_train.sample(
    n=min(50, len(X_train)),
    random_state=42
)

X_shap = X_test.sample(
    n=min(100, len(X_test)),
    random_state=42
)

print("Background:", X_background.shape)
print("SHAP Samples:", X_shap.shape)

def calculate_shap(model_name):

    predict_fn = lambda data: predict_bike(
        model_name,
        pd.DataFrame(
            data,
            columns=X_train.columns
        )
    )

    explainer = shap.PermutationExplainer(
        predict_fn,
        X_background
    )

    shap_values = explainer(
        X_shap,
        max_evals=2 * X_train.shape[1] + 1
    )

    return shap_values

# 세 모델 SHAP 계산
shap_dnn = calculate_shap("DNN")
shap_cnn = calculate_shap("1D-CNN")
shap_rf = calculate_shap("RF")

print("SHAP 계산 완료!")

def aggregate_shap(shap_values):

    values = shap_values.values

    importance = {}

    for feature, columns in feature_groups.items():

        idx = [
            X_train.columns.get_loc(col)
            for col in columns
        ]

        # 같은 원래 변수에 속한 SHAP 값을 합산
        grouped_values = values[:, idx].sum(axis=1)

        importance[feature] = np.mean(
            np.abs(grouped_values)
        )

    return pd.Series(importance)

shap_results = pd.DataFrame({
    "DNN": aggregate_shap(shap_dnn),
    "1D-CNN": aggregate_shap(shap_cnn),
    "Random Forest": aggregate_shap(shap_rf)
})

print(shap_results.round(4))

# PFI 중요도 순위
pfi_rank = pfi_results.rank(
    ascending=False,
    method="min"
)

# SHAP 중요도 순위
shap_rank = shap_results.rank(
    ascending=False,
    method="min"
)

print("===== PFI Ranking =====")
print(pfi_rank.astype(int))

print("\n===== SHAP Ranking =====")
print(shap_rank.astype(int))
